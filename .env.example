# Конфигурация окружения для Yoddle

# Telegram Bot
BOT_TOKEN=ваш_токен_от_botfather
ADMIN_CHAT_ID=ваш_telegram_id

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yoddle_db
DB_USER=postgres
DB_PASSWORD=ваш_пароль

# API
API_BASE_URL=http://localhost:3000
YODDLE_WEB_URL=https://yoddle.ru

# AI API Keys
CLAUDE_API_KEY=ваш_ключ_claude_api
OPENROUTER_API_KEY=ваш_ключ_openrouter_api

# Презентация
PRESENTATION_URL=https://yoddle.ru/yoddle.pdf

# Окружение
NODE_ENV=production
